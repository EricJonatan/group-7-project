# ===== Server =====
NODE_ENV=development
PORT=5000

# ===== MongoDB Atlas =====
# Ambil connection string dari Atlas: Database > Connect > Drivers.
# Ganti <username>, <password>, dan <cluster> sesuai cluster kamu.
# Password WAJIB di-URL-encode kalau mengandung karakter spesial (@ : / ? # [ ] %).
# Nama database ("marketplace") diletakkan sebelum tanda "?".
#   Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marketplace?retryWrites=true&w=majority
#   Lokal:  mongodb://127.0.0.1:27017/marketplace
MONGO_URI=mongodb+srv://yonathanerik_db_user:9VGRYQa0uObBooyp@cluster0.lthvskk.mongodb.net/marketplace?retryWrites=true&w=majority


# Opsional: paksa nama database kalau tidak ditaruh di URI.
# MONGO_DB_NAME=marketplace

# ===== JWT =====
# Buat nilai acak yang panjang, mis.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ===== CORS =====
# Daftar origin frontend yang diizinkan, dipisahkan koma.
# Kosongkan untuk mengizinkan semua origin (hanya untuk dev lokal).
# Contoh: https://nama-web.vercel.app,http://localhost:5173
CLIENT_ORIGINS=

# ===== Seed (opsional) =====
# Dipakai oleh `npm run seed` untuk membuat akun admin demo.
SEED_ADMIN_EMAIL=admin@marketplace.com
SEED_ADMIN_PASSWORD=password123
