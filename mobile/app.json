{
  "expo": {
    "name": "Labuibu",
    "slug": "labuibu",
    "scheme": "labuibu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.labuibu.app" },
