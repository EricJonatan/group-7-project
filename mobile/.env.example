# Leave EXPO_PUBLIC_API_URL unset to preview the labeled demo catalog and checkout.
# Use your computer's LAN IP for a physical phone, Android emulator: 10.0.2.2.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
# Production: HTTPS URL of the deployed web app; used for new API image paths.
# Built-in catalog photos are bundled in the app.
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5173
