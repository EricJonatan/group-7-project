# Backend API URL, including /api. Use HTTPS for production.
# For local API on a physical phone, use LAN IP (e.g. http://192.168.1.10:4000/api), Android emulator: 10.0.2.2.
# Leave empty to preview the offline demo catalog and checkout.
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Deployed web origin for new API image paths; built-in photos are bundled.
EXPO_PUBLIC_WEB_URL=http://localhost:5173
